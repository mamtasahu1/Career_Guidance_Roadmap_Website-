# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to GitHub!

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Create a free cluster → Connect → Drivers → copy the connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Strong random secret for signing JWTs. MUST be 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Email / OTP (Gmail SMTP via App Password) ────────────────────────────────
# How to get SMTP_PASS:
#   Gmail → Settings → Security → 2-Step Verification → App Passwords
#   Generate one for "Mail" and paste the 16-char code below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
EMAIL_FROM=Xyverra <your_gmail@gmail.com>

# ─── Resend (recommended alternative to Gmail SMTP) ───────────────────────────
# Free tier: 3,000 emails/month. Sign up at https://resend.com
# If set, Resend is used as a fallback when SMTP fails.
EMAIL_API_KEY=re_your_resend_api_key_here

# ─── Groq AI ──────────────────────────────────────────────────────────────────
# Free API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash!)
# Example: https://your-site.vercel.app,http://localhost:5500
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:5500
